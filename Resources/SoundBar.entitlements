<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      The app is signed with the hardened runtime (required to be notarized). Not sandboxed: it reads the audio
      processes of the system, taps them and opens a local WebSocket, none of which the sandbox allows.
      Audio input is the one resource the hardened runtime asks to be declared: the app lists and mutes the
      microphone and taps the audio of other apps.
    -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
